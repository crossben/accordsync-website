{
  "name": "@accordsync/client",
  "version": "0.2.0",
  "description": "Accord local-first client: storage adapters, background sync, conflict API",
  "keywords": [
    "offline-first",
    "local-first",
    "sync",
    "crdt",
    "hlc",
    "conflict-resolution",
    "postgresql"
  ],
  "homepage": "https://accord.benhattab.pro/docs/client/",
  "bugs": {
    "url": "https://github.com/crossben/accordsync/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crossben/accordsync.git",
    "directory": "packages/client"
  },
  "type": "module",
  "exports": {
    ".": {
      "@accordsync/source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts --clean --platform node --target node22",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@accordsync/core": "workspace:*"
  },
  "devDependencies": {
    "@accordsync/server": "workspace:*",
    "@accordsync/simulator": "workspace:*",
    "@testcontainers/postgresql": "^12.2.0",
    "fake-indexeddb": "^6.2.5",
    "jose": "^6.2.12",
    "kysely": "^0.29.6"
  }
}
