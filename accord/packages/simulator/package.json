{
  "name": "@accordsync/simulator",
  "version": "0.3.2",
  "description": "Deterministic network and device simulator for Accord convergence tests",
  "keywords": [
    "offline-first",
    "local-first",
    "sync",
    "crdt",
    "hlc",
    "conflict-resolution",
    "postgresql"
  ],
  "homepage": "https://accord.benhattab.pro/",
  "bugs": {
    "url": "https://github.com/crossben/accordsync/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crossben/accordsync.git",
    "directory": "packages/simulator"
  },
  "type": "module",
  "exports": {
    ".": {
      "@accordsync/source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts --clean --platform node --target node22",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@accordsync/core": "workspace:*"
  }
}
