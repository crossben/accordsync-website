{
  "name": "accordsync-website",
  "version": "0.1.0",
  "private": true,
  "description": "The one-page site for Accord, the offline-first sync engine (github.com/crossben/accordsync)",
  "scripts": {
    "predev": "npm run --silent brand && node scripts/sync-app.mjs && node scripts/check-facts.mjs",
    "dev": "next dev",
    "brand": "node scripts/copy-brand.mjs",
    "sync:app": "node scripts/sync-app.mjs",
    "prebuild": "npm run --silent brand && node scripts/sync-app.mjs && node scripts/check-facts.mjs",
    "build": "next build",
    "postbuild": "node scripts/check-seo.mjs",
    "start": "npx serve@latest out",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "check:links": "node scripts/check-links.mjs",
    "check:snippets": "node scripts/check-snippets.mjs",
    "check:seo": "node scripts/check-seo.mjs"
  },
  "dependencies": {
    "@accordsync/core": "0.3.0",
    "@accordsync/simulator": "0.3.0",
    "@gsap/react": "^2.1.2",
    "gsap": "^3.15.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shiki": "^4.5.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "16.3.8",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "eslint": "^9",
    "prettier": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22"
  }
}
